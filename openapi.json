  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "restricted": {
            "type": "boolean"
          }
        },
        "required": [
          "bookId",
          "title",
          "restricted"
        ]
      },
      "Patron": {
        "type": "object",
        "properties": {
          "patronId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "researcherStatus": {
            "type": "boolean"
          },
          "unpaidFeeBalance": {
            "type": "number",
            "format": "decimal"
          }
        },
        "required": [
          "patronId",
          "name",
          "researcherStatus",
          "unpaidFeeBalance"
        ]
      },
      "Loan": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "format": "uuid"
          },
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "patronId": {
            "type": "string",
            "format": "uuid"
          },
          "checkoutDate": {
            "type": "string"
          },
          "dueDate": {
            "type": "string"
          },
          "returnDate": {
            "type": "string"
          }
        },
        "required": [
          "loanId",
          "bookId",
          "patronId",
          "checkoutDate",
          "dueDate"
        ]
      },
      "Hold": {
        "type": "object",
        "properties": {
          "holdId": {
            "type": "string",
            "format": "uuid"
          },
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "patronId": {
            "type": "string",
            "format": "uuid"
          },
          "placedDate": {
            "type": "string"
          },
          "expirationDate": {
            "type": "string"
          },
          "queuePosition": {
            "type": "integer"
          }
        },
        "required": [
          "holdId",
          "bookId",
          "patronId",
          "placedDate",
          "expirationDate",
          "queuePosition"
        ]
      },
      "Fee": {
        "type": "object",
        "properties": {
          "feeId": {
            "type": "string",
            "format": "uuid"
          },
          "patronId": {
            "type": "string",
            "format": "uuid"
          },
          "loanId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "accruedDate": {
            "type": "string"
          },
          "paidAmount": {
            "type": "number",
            "format": "decimal"
          }
        },
        "required": [
          "feeId",
          "patronId",
          "loanId",
          "amount",
          "accruedDate",
          "paidAmount"
        ]
      },
      "RegisterBookRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "restricted": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "restricted"
        ]
      },
      "RegisterBookResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
