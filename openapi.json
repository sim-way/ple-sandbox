{
  "openapi": "3.0.0",
  "info": {
    "title": "Billing API",
    "version": "1.0.0",
    "description": "API for Billing domain"
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Development server"
    }
  ],
  "paths": {
    "/subscription": {
      "get": {
        "summary": "List all Subscriptions",
        "operationId": "listSubscriptions",
        "responses": {
          "200": {
            "description": "A list of Subscription instances",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Subscription"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/subscription/{subscriptionrootId}": {
      "get": {
        "summary": "Get Subscription by ID",
        "operationId": "getSubscriptionById",
        "parameters": [
          {
            "name": "subscriptionrootId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          },
          "404": {
            "description": "Subscription not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Subscription": {
        "type": "object",
        "properties": {
          "subscriptionrootId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "planType": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "SubscriptionRoot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "planType": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ]
      }
    }
  }
}